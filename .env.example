# AgentOS configuration. Copy to .env and adjust. Every variable is prefixed with AGENTOS_.
# Never commit a real .env (it is git-ignored).

# --- core -------------------------------------------------------------------------------
AGENTOS_ENVIRONMENT=development
AGENTOS_LOG_LEVEL=INFO
AGENTOS_LOG_JSON=true

# PostgreSQL (source of truth). Docker Compose uses the `postgres` service name.
AGENTOS_DATABASE_URL=postgresql+psycopg://agentos:agentos@localhost:5432/agentos
# Redis (optional: rate limiting, worker wake-ups, caching). Leave empty to disable.
AGENTOS_REDIS_URL=redis://localhost:6379/0

# --- API --------------------------------------------------------------------------------
AGENTOS_API_PORT=8000
AGENTOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development convenience: if no API keys exist, create one with this value at startup.
# Use `python -m app.cli create-key` instead in any shared environment.
AGENTOS_BOOTSTRAP_API_KEY=
AGENTOS_TASK_CREATE_RATE_PER_MINUTE=30
# Allow the creator of a task to approve its own sensitive operations (single-user dev only).
AGENTOS_ALLOW_SELF_APPROVAL=false

# --- LLM provider -----------------------------------------------------------------------
# fake = deterministic scripted provider (no API calls, no cost); anthropic = Claude.
AGENTOS_LLM_PROVIDER=fake
AGENTOS_LLM_MODEL=claude-opus-5-5
AGENTOS_LLM_EFFORT=medium
AGENTOS_ANTHROPIC_API_KEY=
AGENTOS_ANTHROPIC_REFUSAL_FALLBACK=true

# --- sandbox ----------------------------------------------------------------------------
# docker = isolated container (recommended). local = restricted subprocess, NOT isolation.
AGENTOS_SANDBOX_BACKEND=docker
AGENTOS_SANDBOX_IMAGE=agentos-sandbox:latest
AGENTOS_SANDBOX_TIMEOUT_S=60

# --- budgets & reliability --------------------------------------------------------------
AGENTOS_MAX_GRAPH_STEPS=60
AGENTOS_MAX_SUBTASK_ATTEMPTS=3
AGENTOS_MAX_CONCURRENT_AGENTS=3
AGENTOS_TASK_DEADLINE_S=900
AGENTOS_LEASE_SECONDS=30
AGENTOS_HEARTBEAT_INTERVAL_S=5
AGENTOS_WORKER_CONCURRENCY=2

# --- observability ----------------------------------------------------------------------
# OTLP/HTTP endpoint of an OpenTelemetry collector, e.g. http://localhost:4318
AGENTOS_OTEL_EXPORTER_OTLP_ENDPOINT=
AGENTOS_PERSIST_SPANS=true
AGENTOS_WORKER_METRICS_PORT=9101

# --- evaluation (never in production) ---------------------------------------------------
# Enables scripted scenarios, fault injection and workflow-mode overrides in task options.
AGENTOS_EVALUATION_MODE=false
